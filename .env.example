# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret! Server only.
SUPABASE_SERVICE_ROLE_KEY=

# platform.openai.com → API keys. Secret! Server only.
OPENAI_API_KEY=

# Moyasar (not used yet in phase 1 — test payment button is used instead)
MOYASAR_SECRET_KEY=
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=

# platform.claude.com → API Keys (film branch text). Secret! Server only.
ANTHROPIC_API_KEY=

# «لأجل المهدي» reminders (Web Push). Generate them with:  npx tsx scripts/generate-mahdi-vapid.mts
# The public key is read at build time (redeploy after adding it). The private key and the cron secret are secrets: server only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# At least 24 characters. The same value goes into supabase/migrations/0009_mahdi_notifications_cron.sql
MAHDI_CRON_SECRET=

# Ads (every one optional: nothing loads or fires without it). The browser pixels are read at build time (redeploy after
# adding one): Meta Pixel, TikTok Pixel and Snap Pixel ids from each network's Events Manager.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAP_PIXEL_ID=
# Meta Conversions API: the Purchase is also sent from the server when the owner confirms a top-up (same event id as the
# browser's, counted once). Events Manager → Settings → Conversions API → Generate access token. Secret! Server only.
META_CAPI_TOKEN=
# optional, while checking: Events Manager → Test events → the code; the server events then show up there
META_CAPI_TEST_CODE=

# Paylink (card, mada, Apple Pay, STC Pay on «اشحن رصيدك»): the card button shows only when both keys are set.
# PAYLINK_BASE: https://restpilot.paylink.sa for the TEST account, nothing (or https://restapi.paylink.sa) for live.
PAYLINK_API_ID=
PAYLINK_SECRET_KEY=
PAYLINK_BASE=
# optional second address to try (a URL, or the word production / test)
PAYLINK_BASE1=
# optional: the webhook (my.paylink.sa → PAYMENT WEBHOOK → https://www.aljawadai.app/api/credits/paylink/webhook) sends it as X-Webhook-Secret
PAYLINK_WEBHOOK_SECRET=
