{
  "name": "haidara-cut",
  "productName": "الجواد AI",
  "version": "1.2.2",
  "description": "الجواد AI: صور وفيديوهات وأصوات بالذكاء الاصطناعي، وحيدرة كت للمونتاج",
  "author": "نهج علي",
  "homepage": "https://www.aljawadai.app/jawad-ai/editor",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux dir --publish never"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "app.nahjali.haidaracut",
    "productName": "الجواد AI",
    "executableName": "JawadAI",
    "copyright": "© 2026 نهج علي",
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "الجواد AI يستخدم المايك لتسجيل صوتك.",
        "NSCameraUsageDescription": "الجواد AI يستخدم الكاميرا للتسجيل."
      },
      "artifactName": "JAWAD-AI-mac.${ext}",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "identity": "-"
    },
    "dmg": {
      "title": "الجواد AI",
      "window": {
        "width": 560,
        "height": 440
      },
      "contents": [
        {
          "x": 150,
          "y": 170
        },
        {
          "x": 410,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 280,
          "y": 330,
          "type": "file",
          "path": "build/mac-guide.pdf",
          "name": "اقرأني أول - طريقة الفتح.pdf"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "JAWAD-AI-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "الجواد AI",
      "installerLanguages": [
        "ar_SA",
        "en_US"
      ],
      "language": "1025"
    },
    "linux": {
      "target": "dir",
      "icon": "build/icon.png"
    },
    "afterSign": "notarize.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yymm40-create/nahjali.git"
  }
}
